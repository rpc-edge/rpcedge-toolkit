{
  "name": "rpcedge-core",
  "version": "0.1.2",
  "description": "Shared client core for rpc edge: endpoints, auth, JSON-RPC, health, fees, and transaction relay helpers.",
  "type": "module",
  "license": "MIT",
  "author": "0xNyk <0xnykcd@googlemail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rpc-edge/rpcedge-toolkit.git",
    "directory": "packages/core"
  },
  "homepage": "https://rpcedge.com",
  "bugs": {
    "url": "https://github.com/rpc-edge/rpcedge-toolkit/issues"
  },
  "keywords": [
    "solana",
    "rpc",
    "rpcedge",
    "rpc-edge",
    "trading",
    "hft"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "pnpm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@triton-one/yellowstone-grpc": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@triton-one/yellowstone-grpc": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@triton-one/yellowstone-grpc": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@triton-one/yellowstone-grpc": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
