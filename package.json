{
  "name": "rpcedge-toolkit",
  "private": true,
  "version": "0.1.0",
  "description": "rpc edge developer toolkit: TypeScript SDK, CLI, and MCP server for Solana trading infra.",
  "license": "MIT",
  "author": "0xNyk <0xnykcd@googlemail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/rpc-edge/rpcedge-toolkit.git"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "pnpm -r --filter './packages/*' run --if-present test",
    "clean": "pnpm -r --filter './packages/*' run --if-present clean && rm -rf packages/*/dist",
    "cli": "pnpm --filter rpcedge exec node dist/index.js",
    "mcp": "pnpm --filter rpcedge-mcp exec node dist/index.js",
    "version:set": "node scripts/set-version.mjs",
    "publish:dry": "node scripts/publish.mjs --dry-run",
    "publish:npm": "node scripts/publish.mjs",
    "release:tag": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
